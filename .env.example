# OPTIONAL. Canonical site URL — drives canonical tags, Open Graph URLs,
# sitemap.xml and robots.txt.
#
# On Vercel you can leave this unset: the production domain is picked up
# automatically from VERCEL_PROJECT_PRODUCTION_URL.
#
# Set it only when using a custom domain. A protocol is optional and a
# trailing slash is stripped, so all of these work:
#   https://rohitmanora.com
#   rohitmanora.com
#   https://rohitmanora.com/
#
# Leaving the key present but BLANK is treated the same as unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
